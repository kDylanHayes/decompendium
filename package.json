{
  "name": "decompendium",
  "version": "0.0.0",
  "private": true,
  "description": "A public directory of matching decompilation projects.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "validate": "node src/cli/validate.ts",
    "classify-pr": "node src/cli/classify-pr.ts",
    "test": "node --test \"tests/**/*.test.ts\"",
    "typecheck": "tsc",
    "check": "pnpm typecheck && pnpm test && pnpm validate",
    "ingest": "node src/cli/ingest.ts",
    "build": "astro build && pagefind --site dist",
    "dev": "astro dev",
    "preview": "astro preview",
    "discover": "node src/cli/discover.ts"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "astro": "^7.3.8",
    "fflate": "^0.8.3",
    "protobufjs": "^8.8.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "pagefind": "^1.5.2",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@12.11.2"
}
