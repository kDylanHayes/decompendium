---
import ProgressBar from "../../components/ProgressBar.astro";
import Layout from "../../layouts/Layout.astro";
import { AI_POLICY_LABELS, exactTime, number, platformName, relativeTime, shortDate, STATUS_LABELS } from "../../../src/site/format.ts";
import { percent, type ProjectView } from "../../../src/site/model.ts";
import { issueUrl, site, url } from "../../lib/data.ts";

export function getStaticPaths() {
  return site().projects.map((project) => ({ params: { id: project.id }, props: { project } }));
}

const { project } = Astro.props as { project: ProjectView };
const now = new Date(site().builtAt);
const ratio = (c: { matched: number; total: number }, unit: string) => `${number(c.matched)} / ${number(c.total)} ${unit}`;

const optOut = issueUrl(
  `Opt out: ${project.id}`,
  [
    `Project: ${project.name} (${project.repo})`,
    "",
    "I maintain this project and would like to (keep one):",
    "- [ ] remove it from Decompendium entirely",
    "- [ ] keep it on its game page but hide it from the home page",
    "",
    "Removal requests are carried out within 48 hours, no questions asked.",
  ].join("\n"),
);
const correction = issueUrl(`Correction: ${project.id}`, `Project: ${project.name}\n\nWhat should change:\n`);
---

<Layout title={project.name} description={project.description}>
  <div data-pagefind-body>
    <p class="small muted">
      <a href={url(`games/${project.game.id}/`)}>{project.game.name}</a> / {platformName(project.game.platform)}
    </p>
    <h1 data-pagefind-meta="title">{project.name}</h1>
    <p class="lede">{project.description}</p>
    {project.note && <p class="notice">Maintainer note: {project.note}</p>}

    <dl class="facts" data-pagefind-ignore>
      <dt>Repository</dt>
      <dd><a href={project.repo}>{project.repoName}</a></dd>
      <dt>Status</dt>
      <dd>{STATUS_LABELS[project.status]}{project.quiet && ", quiet (no commits for 180 days)"}</dd>
      <dt>Last commit</dt>
      <dd>
        <time datetime={project.lastCommitAt ?? undefined} title={exactTime(project.lastCommitAt)}
          >{project.lastCommitAt ? `${shortDate(project.lastCommitAt)} (${relativeTime(project.lastCommitAt, now)})` : "unknown"}</time
        >
      </dd>
      <dt>AI contributions</dt>
      <dd>{AI_POLICY_LABELS[project.aiPolicy]}</dd>
      <dt>Maintainers</dt>
      <dd>
        {project.owners.map((o, i) => <>{i > 0 && ", "}<a href={`https://github.com/${o}`}>{o}</a></>)}
        {project.confirmed ? <span class="chip good">Maintainer confirmed</span> : <span class="muted"> (not yet confirmed by a maintainer)</span>}
      </dd>
      {project.links.contributing && <><dt>Contributing</dt><dd><a href={project.links.contributing}>Guide</a></dd></>}
      {project.links.chat && <><dt>Chat</dt><dd><a href={project.links.chat}>Join</a></dd></>}
      {project.links.website && <><dt>Website</dt><dd><a href={project.links.website}>{project.links.website}</a></dd></>}
      <dt>Listed</dt>
      <dd>{shortDate(project.listedAt)}</dd>
    </dl>

    <h2>Targets</h2>
    {
      project.targets.map((t) => (
        <section class="card" id={t.id}>
          <h3>
            {t.label}
            {t.state === "stale" && <span class="chip warn">Stale data</span>}
            {t.state === "failing" && <span class="chip bad">Fetch failing</span>}
          </h3>
          <p class="small muted hash">
            {t.hash.algo.toUpperCase()} <span class="mono">{t.hash.value}</span>
          </p>
          {t.latest ? (
            <>
              <ProgressBar code={t.latest.code} linked={t.latest.linked} large />
              <dl class="stats">
                <div><dt>Matched code</dt><dd>{percent(t.latest.code)}</dd><dd class="detail">{ratio(t.latest.code, "bytes")}</dd></div>
                {t.latest.linked && <div><dt>Fully linked</dt><dd>{percent(t.latest.linked)}</dd><dd class="detail">{ratio(t.latest.linked, "bytes")}</dd></div>}
                {t.latest.functions && <div><dt>Functions</dt><dd>{percent(t.latest.functions)}</dd><dd class="detail">{ratio(t.latest.functions, "functions")}</dd></div>}
                {t.latest.data && t.latest.data.total > 0 && <div><dt>Data</dt><dd>{percent(t.latest.data)}</dd><dd class="detail">{ratio(t.latest.data, "bytes")}</dd></div>}
                {t.latest.fuzzy_percent !== null && <div><dt>Fuzzy match</dt><dd>{t.latest.fuzzy_percent.toFixed(1)}%</dd><dd class="detail">including partial matches</dd></div>}
              </dl>
              {t.latest.categories.length > 0 && (
                <details class="categories">
                  <summary>Categories</summary>
                  <div class="table-wrap">
                    <table>
                      <thead><tr><th>Category</th><th class="num">Matched code</th><th class="num">Fully linked</th></tr></thead>
                      <tbody>
                        {t.latest.categories.map((c) => (
                          <tr><td>{c.name || c.id}</td><td class="num">{percent(c.code) ?? "—"}</td><td class="num">{percent(c.linked) ?? "—"}</td></tr>
                        ))}
                      </tbody>
                    </table>
                  </div>
                </details>
              )}
              <p class="small muted card-foot">
                {t.latest.commit ? (
                  <>Commit <a class="mono" href={`${project.repo}/commit/${t.latest.commit}`}>{t.latest.commit.slice(0, 7)}</a>{t.latest.commit_at && <>, {shortDate(t.latest.commit_at)}</>}. </>
                ) : null}
                Checked <time datetime={t.checkedAt ?? undefined} title={exactTime(t.checkedAt)}>{relativeTime(t.checkedAt, now)}</time>.
                {t.state === "failing" && t.error && <> Last error: {t.error}</>}
              </p>
            </>
          ) : (
            <p class="muted small">
              {t.kind === "none"
                ? "No progress data published."
                : t.error
                  ? `No progress data yet. Last error: ${t.error}`
                  : "No progress data yet."}
            </p>
          )}
        </section>
      ))
    }
  </div>

  <h2>Maintainers</h2>
  <p class="small">
    Edit this entry with a pull request to <a href={`https://github.com/kDylanHayes/decompendium/blob/main/catalog/projects/${project.id}.yaml`}><code>catalog/projects/{project.id}.yaml</code></a>,{" "}
    or <a href={correction}>report a correction</a>. Don't want to be listed? <a href={optOut}>Opt out</a>; you can hide the
    project from the home page or remove it entirely.
  </p>
</Layout>
